{
  "name": "study-trio",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "wrangler d1 migrations apply study-trio --local",
    "dev": "wrangler dev",
    "db:init:remote": "wrangler d1 migrations apply study-trio --remote",
    "deploy": "wrangler deploy",
    "seed": "node scripts/seed.mjs",
    "test": "node scripts/smoke.mjs",
    "db:reset": "rm -rf .wrangler/state && wrangler d1 migrations apply study-trio --local",
    "user:add": "node scripts/add-user.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.142.0"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  }
}
