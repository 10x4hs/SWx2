{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swx2",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"], // src/lib/budget.js 가 크론마다 바깥 요청 수를 세요 (AsyncLocalStorage)
  // 워커를 D1(아시아) 가까이에서 돌려요 — 쿼리마다 태평양을 건너지 않게
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pf/*", "/px/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  // 무료 플랜 최대 5개. 무엇이 언제 도는지는 src/cron.js 맨 위 (00:05 자동 저장 · 일 22:00 회고 · 08:00 뉴스 · 매시 10분 알림+뉴스 · 23:10 신문 마감)
  "triggers": { "crons": ["5 15 * * *", "0 13 * * SUN", "0 23 * * *", "10 * * * *", "10 14 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsm-mafia",
      // 배포 DB id (npm run deploy:all 이 알아서 써 넣어요)
      "database_id": "0303dd60-ab34-409f-b4e9-39aff1cde845",
      // 로컬(wrangler dev · --local)은 이 id 로 파일을 찾아요. 바꾸면 로컬 데이터가 안 보여요!
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 실시간 대화: 웹소켓을 붙잡아 두는 Durable Object 하나 (src/hub.js)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dsm-mafia-files" }], // 노트 이미지 · 첨부 (Notion 에서 옮긴 사진 등)
  "durable_objects": { "bindings": [{ "name": "ROOM_HUB", "class_name": "RoomHub" }] },
  // 뜻으로 찾기 (src/rag.js): Workers AI 임베딩 @cf/baai/bge-m3 (1024차원). wrangler dev 에서도 늘 원격이라 계정의 무료 뉴런(하루 10,000)을 써요
  "ai": { "binding": "AI" },
  // 벡터 색인 둘 (cosine · 1024): 배포본은 VECTORS(swx2-chunks) 만, wrangler dev 는 VECTORS_DEV(swx2-chunks-dev, remote) 만 써요 (src/rag.js vecIndex — 로컬 표시 PASSWORDLESS=1).
  // VECTORS 는 remote 가 아니라서 로컬에서는 배포 색인에 닿지 않아요 → 개발 중 넣은 노트 · 시험 벡터가 배포 색인을 더럽히지 않아요.
  // 메타데이터 색인(kind · user_id)은 벡터를 넣기 전에 만들어 뒀어요. 무료 저장 5M 차원은 계정 전체 몫 (두 색인 합)
  "vectorize": [
    { "binding": "VECTORS", "index_name": "swx2-chunks" },
    { "binding": "VECTORS_DEV", "index_name": "swx2-chunks-dev", "remote": true }
  ],
  "migrations": [{ "tag": "hub-v1", "new_sqlite_classes": ["RoomHub"] }],
  "vars": { "PASSWORDLESS": "0", "VAPID_PUBLIC_KEY": "BM5EpcANa6q_5MpqXGMuxMIwwNlNfPCUoxf10NSsSEg6dBxu3pSZVgohkTtdDZ3fFHORgFThI9gEOTcRPR0T-h4" } // 배포본은 비밀번호 필수. 로컬은 .dev.vars 의 PASSWORDLESS=1 이 덮어써요
}
