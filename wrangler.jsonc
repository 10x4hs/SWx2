{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsm-mafia",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 매일 15:05 UTC = 00:05 한국 시간: 지난 하루 기록 자동 저장
  "triggers": { "crons": ["5 15 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsm-mafia",
      // 배포 DB id (npm run deploy:all 이 알아서 써 넣어요)
      "database_id": "0303dd60-ab34-409f-b4e9-39aff1cde845",
      // 로컬(wrangler dev · --local)은 이 id 로 파일을 찾아요. 바꾸면 로컬 데이터가 안 보여요!
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "MAX_USERS": "3", "PASSWORDLESS": "0" } // 배포본은 비밀번호 필수. 로컬은 .dev.vars 의 PASSWORDLESS=1 이 덮어써요
}
