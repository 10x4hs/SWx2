{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsm-mafia",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"], // src/lib/budget.js 가 크론마다 바깥 요청 수를 세요 (AsyncLocalStorage)
  // 워커를 D1(아시아) 가까이에서 돌려요 — 쿼리마다 태평양을 건너지 않게
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pf/*", "/px/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  // 무료 플랜 최대 5개. 무엇이 언제 도는지는 src/cron.js 맨 위 (00:05 자동 저장 · 일 22:00 회고 · 08:00 뉴스 · 매시 10분 알림+뉴스 · 23:10 신문 마감)
  "triggers": { "crons": ["5 15 * * *", "0 13 * * SUN", "0 23 * * *", "10 * * * *", "10 14 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsm-mafia",
      // 배포 DB id (npm run deploy:all 이 알아서 써 넣어요)
      "database_id": "0303dd60-ab34-409f-b4e9-39aff1cde845",
      // 로컬(wrangler dev · --local)은 이 id 로 파일을 찾아요. 바꾸면 로컬 데이터가 안 보여요!
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 실시간 대화: 웹소켓을 붙잡아 두는 Durable Object 하나 (src/hub.js)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dsm-mafia-files" }], // 노트 이미지 · 첨부 (Notion 에서 옮긴 사진 등)
  "durable_objects": { "bindings": [{ "name": "ROOM_HUB", "class_name": "RoomHub" }] },
  "migrations": [{ "tag": "hub-v1", "new_sqlite_classes": ["RoomHub"] }],
  "vars": { "MAX_USERS": "3", "PASSWORDLESS": "0", "VAPID_PUBLIC_KEY": "BM5EpcANa6q_5MpqXGMuxMIwwNlNfPCUoxf10NSsSEg6dBxu3pSZVgohkTtdDZ3fFHORgFThI9gEOTcRPR0T-h4" } // 배포본은 비밀번호 필수. 로컬은 .dev.vars 의 PASSWORDLESS=1 이 덮어써요
}
