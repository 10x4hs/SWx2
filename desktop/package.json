{
  "name": "dsm-mafia-desktop",
  "productName": "Dsm-mafia",
  "version": "0.1.0",
  "description": "Dsm-mafia 데스크톱 — 왼쪽은 공부 앱, 오른쪽은 진짜 브라우저 탭 (YouTube · 로그인 다 돼요)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --universal",
    "dist:arm": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.dsm-mafia.desktop",
    "productName": "Dsm-mafia",
    "mac": { "category": "public.app-category.education", "target": ["dmg", "zip"], "icon": "icon.png", "identity": null },
    "directories": { "output": "dist" },
    "files": ["main.js", "preload-app.js", "preload-chrome.js", "chrome.html", "icon.png"]
  }
}
